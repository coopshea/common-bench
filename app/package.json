{
  "name": "common-bench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "node data/generate.ts",
    "tokens": "node src/ds/build-tokens.ts",
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch --env-file-if-exists=.env.local server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch --env-file-if-exists=.env.local server/index.ts",
    "build": "tsc -b && vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc -b --noEmit",
    "managed:setup": "tsx --env-file-if-exists=.env.local managed/setup.ts",
    "managed:ask": "tsx --env-file-if-exists=.env.local managed/ask.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.296",
    "@anthropic-ai/sdk": "^0.133.0",
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@hono/node-server": "^2.1.5",
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "date-fns": "^4.1.0",
    "hono": "^4.13.13",
    "katex": "^0.16.22",
    "react": "^19.3.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-big-calendar": "^1.16.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
